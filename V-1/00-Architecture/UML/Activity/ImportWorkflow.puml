@startuml ImportWorkflow

title Import Workflow

start

:Seleccionar documento;
:Detectar formato;

if (¿Requiere OCR?) then (Sí)
  :Ejecutar OCR;
else (No)
  :Extraer texto directo;
endif

:Extraer contenido;
:Analizar estructura;
:Construir UDM;
:Validar UDM;

if (¿UDM válido?) then (Sí)
  :Incorporar a Library;
  :Publicar DocumentCreated;
else (No)
  :Publicar ImportFailed;
endif

stop

@enduml