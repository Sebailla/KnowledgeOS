@startuml DomainModel_Class

title KnowledgeOS - Domain Model

class Library {
  UUID id
  String name
}

class Workspace {
  UUID id
  String name
}

class Collection {
  UUID id
  String name
}

class Document {
  UUID id
  String title
  DocumentStatus status
}

class OriginalDocument {
  UUID id
  String path
  String hash
  String format
}

class DocumentVersion {
  UUID id
  String processingVersion
  Date createdAt
}

class UDMDocument {
  UUID id
}

class UDMNode {
  UUID id
  String type
}

class Metadata {
  UUID id
  String title
  String author
  String language
}

class Asset {
  UUID id
  String type
  String hash
}

class Annotation {
  UUID id
  String type
}

class Reference {
  UUID id
  String type
  String target
}

class KnowledgeGraph {
  UUID id
}

class GraphNode {
  UUID id
  String type
}

class GraphEdge {
  UUID id
  String relation
}

class Job {
  UUID id
  JobStatus status
}

class Plugin {
  UUID id
  String name
  String version
}

Library "1" --> "*" Workspace
Library "1" --> "*" Collection
Library "1" --> "*" Document
Library "1" --> "*" Asset
Library "1" --> "*" Job
Library "1" --> "*" Plugin
Library "1" --> "1" KnowledgeGraph

Document "1" --> "1" OriginalDocument
Document "1" --> "*" DocumentVersion
Document "1" --> "1" UDMDocument
Document "1" --> "1" Metadata
Document "1" --> "*" Asset
Document "1" --> "*" Annotation
Document "1" --> "*" Reference

UDMDocument "1" --> "*" UDMNode
UDMNode "1" --> "*" UDMNode

KnowledgeGraph "1" --> "*" GraphNode
KnowledgeGraph "1" --> "*" GraphEdge

Collection "*" --> "*" Document
Workspace "*" --> "*" Collection

@enduml