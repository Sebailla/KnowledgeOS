@startuml AnnotationModel_Class

title Annotation Model

abstract class Annotation {
  UUID id
  UUID documentId
  Date createdAt
  Date updatedAt
}

class Highlight {
  String range
}

class Underline {
  String range
}

class TextNote {
  String text
}

class StickyNote {
  String text
  String style
}

class Ink {
  String strokes
}

class Bookmark {
  String label
}

class AnnotationAnchor {
  UUID udmNodeId
  Integer startOffset
  Integer endOffset
}

class HighlightStyle {
  String colorFamily
  String intensity
  Float opacity
  String blendMode
}

Annotation <|-- Highlight
Annotation <|-- Underline
Annotation <|-- TextNote
Annotation <|-- StickyNote
Annotation <|-- Ink
Annotation <|-- Bookmark

Annotation "1" --> "1" AnnotationAnchor
Highlight "1" --> "1" HighlightStyle
Underline "1" --> "1" HighlightStyle

@enduml