server {
  listen 443 ssl;
  server_name _;

  ssl_certificate /run/secrets/master_library_tls_certificate;
  ssl_certificate_key /run/secrets/master_library_tls_private_key;

  location = /health/ready {
    proxy_pass http://master-library:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Correlation-Id $http_x_correlation_id;
  }

  location /v1/ {
    proxy_pass http://master-library:8081;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Correlation-Id $http_x_correlation_id;
  }

  location / {
    proxy_pass http://master-library-browser:8090;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Correlation-Id $http_x_correlation_id;
  }
}
