@startuml C4-L3-PlatformEngines
!include <C4/C4_Component>
title KnowledgeOS — Platform Engines
Container_Boundary(platform,"Platform") {
 Component(library,"Library Engine","Master/Local library membership and acquisition")
 Component(import,"Import Engine","Scanning, intake and validation")
 Component(knowledge,"Knowledge Engine","Knowledge Objects and graph")
 Component(search,"Search Engine","Indexes and queries")
 Component(render,"Render Engine","UDM/DPM rendering")
 Component(annotation,"Annotation Engine","Personal Knowledge annotations")
 Component(sync,"Sync Engine","Personal Knowledge convergence")
 Component(ai,"AI Engine","Policy-controlled AI tasks")
 Component(export,"Export Engine","Portable exports")
 Component(plugin,"Plugin Engine","Capabilities and extensions")
}
Rel(library,import,"Coordinates acquisition/import")
Rel(import,knowledge,"Publishes validated sources/canonical inputs")
Rel(knowledge,search,"Projects indexable knowledge")
Rel(knowledge,render,"Provides UDM/DPM")
Rel(annotation,sync,"Publishes Personal Knowledge changes")
Rel(ai,knowledge,"Produces derived suggestions")
Rel(export,knowledge,"Reads approved knowledge")
Rel(plugin,library,"Uses public contracts")
Rel(plugin,knowledge,"Uses public contracts")
@enduml
