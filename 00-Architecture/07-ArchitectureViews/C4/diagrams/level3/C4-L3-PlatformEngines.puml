@startuml C4-L3-PlatformEngines
title KnowledgeOS — C4 Level 3 — Platform Engines
caption Architecture V3.0

skinparam componentStyle rectangle
skinparam shadowing false

package "Platform" {
  component "Library Engine" as library
  component "Knowledge Engine" as knowledge
  component "Import Engine" as import
  component "Export Engine" as export
  component "Render Engine" as render
  component "Search Engine" as search
  component "Annotation Engine" as annotation
  component "AI Engine" as ai
  component "Plugin Engine" as plugin
  component "Sync Engine" as sync
}

package "Domain" {
  component "Knowledge Object" as ko
  component "UDM" as udm
  component "DPM" as dpm
  component "Knowledge Graph" as kg
}

package "Kernel" {
  component "Command / Query / Event Buses" as buses
  component "Job System / Workflow Engine / Scheduler" as jobs
}

package "Integration" {
  component "Providers" as providers
  component "Storage & Synchronization" as storage
  component "Public API" as api
  component "Plugin SDK" as sdk
  component "Data Exchange" as exchange
}

library --> ko
knowledge --> kg
knowledge --> udm
import --> udm
import --> dpm
export --> exchange
render --> dpm
search --> udm
search --> kg
annotation --> udm
annotation --> dpm
ai --> providers
plugin --> sdk
sync --> storage
library --> storage

library --> buses
knowledge --> buses
import --> jobs
export --> jobs
search --> jobs
ai --> jobs
sync --> jobs

api --> buses
providers ..> ai
providers ..> import
providers ..> export

note bottom
  Engines own product capabilities.
  Integration owns external boundaries.
  Kernel owns coordination infrastructure.
  Domain owns canonical knowledge semantics.
end note

footer KnowledgeOS Architecture | C4 Model | Version 3.0
@enduml
