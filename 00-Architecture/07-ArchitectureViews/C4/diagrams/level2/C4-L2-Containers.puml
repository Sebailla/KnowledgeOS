@startuml C4-L2-Containers
!include <C4/C4_Container>
title KnowledgeOS — Containers
Person(user,"User")
System_Boundary(kos,"KnowledgeOS") {
 Container(mac,"macOS Client","Native application","Selective Local Library; offline reading and processing")
 Container(ios,"iPhone/iPad Client","Native application","Selective Local Library; reading and Personal Knowledge")
 Container(web,"Web Client","Optional web application","Remote access profile")
 Container(server,"KnowledgeOS Server","NAS application container","Master Catalog, publication delivery and server APIs")
 ContainerDb(masterdb,"Master Database","PostgreSQL container","Master metadata and catalog")
 Container(masterfiles,"Authoritative Files","Persistent NAS volume","Source publications")
 ContainerDb(localdb,"Local Library Storage","Device-local repositories","Local publications, indexes and Personal Knowledge")
 Container(icloud,"CloudKit Provider","Apple service","Personal Knowledge transport only")
}
Rel(user,mac,"Uses")
Rel(user,ios,"Uses")
Rel(user,web,"Uses")
Rel(mac,server,"Browse and acquire selected publications","HTTPS")
Rel(ios,server,"Browse and acquire selected publications","HTTPS")
Rel(web,server,"Uses public API","HTTPS")
Rel(server,masterdb,"Reads/writes catalog")
Rel(server,masterfiles,"Reads/writes authoritative files")
Rel(mac,localdb,"Reads/writes local state")
Rel(ios,localdb,"Reads/writes local state")
Rel(mac,icloud,"Sync Personal Knowledge")
Rel(ios,icloud,"Sync Personal Knowledge")
@enduml
