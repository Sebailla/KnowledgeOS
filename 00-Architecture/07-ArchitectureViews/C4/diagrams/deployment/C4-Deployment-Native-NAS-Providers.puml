@startuml C4-Deployment-Native-NAS-Providers
!include <C4/C4_Deployment>
title KnowledgeOS — Deployment
Deployment_Node(apple,"Apple Devices","macOS / iOS / iPadOS") {
 Container(client,"KnowledgeOS Native Client","Native application")
 ContainerDb(local,"Local Repositories","Device storage")
}
Deployment_Node(nas,"User NAS","Container runtime") {
 Container(server,"KnowledgeOS Server","Application container")
 ContainerDb(pg,"PostgreSQL","Database container")
 Container(files,"Master Files","Independent persistent volume")
}
Deployment_Node(cloud,"External Providers") {
 Container(icloud,"iCloud / CloudKit","Personal sync provider")
 Container(ai,"AI / OCR / Metadata Providers","Optional services")
}
Rel(client,local,"Offline local operation")
Rel(client,server,"Catalog browsing and explicit acquisition","HTTPS")
Rel(server,pg,"Master catalog")
Rel(server,files,"Authoritative publication files")
Rel(client,icloud,"Personal Knowledge synchronization")
Rel(client,ai,"Policy-approved tasks")
@enduml
