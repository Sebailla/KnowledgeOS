@startuml Level2-Containers
!include ../styles/KnowledgeOS.puml
!include <C4/C4_Container>

title Container Diagram - KnowledgeOS

Person(user, "Usuario")

System_Boundary(knowledgeos, "KnowledgeOS") {
    Container(cli, "CLI", "Node.js", "Interfaz de línea de comandos")
    Container(kernel, "Kernel", "Core", "Orquestador central y event bus")
    Container(platform, "Platform", "Runtime", "Config, logging, plugin loader")
    Container(engines, "Engines", "Modules", "Import, Storage, Rendering, Search, AI, etc.")
    ContainerDb(store, "File Store", "Markdown Files", "Contenido y metadata")
}

System_Ext(ai, "AI Providers")
System_Ext(git, "Git/Cloud")

Rel(user, cli, "Usa")
Rel(cli, kernel, "Comandos")
Rel(kernel, platform, "Depende de")
Rel(kernel, engines, "Coordina")
Rel(engines, store, "Lee/Escribe")
Rel(engines, ai, "Consulta")
Rel(kernel, git, "Sincroniza")

@enduml
