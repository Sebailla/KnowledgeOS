@startuml Level3-Kernel
!include ../styles/KnowledgeOS.puml
!include <C4/C4_Component>

title Component Diagram - Kernel

Container(kernel, "Kernel", "Core", "Orquestador central")

Container_Boundary(kernel_internals, "Kernel Internals") {
    Component(eventbus, "Event Bus", "Pub/Sub", "Comunicación entre módulos")
    Component(orchestrator, "Orchestrator", "Coordinator", "Flujo principal de operaciones")
    Component(registry, "Registry", "Registry", "Registro de módulos y capacidades")
    Component(lifecycle, "Lifecycle", "Manager", "Inicialización y shutdown")
}

Rel(eventbus, orchestrator, "Notifica")
Rel(orchestrator, registry, "Consulta")
Rel(lifecycle, registry, "Inicializa")

@enduml
