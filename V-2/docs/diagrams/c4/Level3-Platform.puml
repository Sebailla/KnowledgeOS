@startuml Level3-Platform
!include ../styles/KnowledgeOS.puml
!include <C4/C4_Component>

title Component Diagram - Platform

Container(platform, "Platform", "Runtime", "Servicios transversales")

Container_Boundary(platform_internals, "Platform Internals") {
    Component(config, "Config", "Manager", "Configuración y validación")
    Component(logger, "Logger", "Structured", "Logging centralizado")
    Component(pluginloader, "Plugin Loader", "Discovery", "Carga y registro de plugins")
    Component(errors, "Error Handler", "Handler", "Manejo centralizado de errores")
}

Rel(config, logger, "Configura")
Rel(pluginloader, config, "Lee config")

@enduml
