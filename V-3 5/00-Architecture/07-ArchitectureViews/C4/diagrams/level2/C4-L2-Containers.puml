@startuml C4-L2-Containers
title KnowledgeOS — C4 Level 2 — Containers
caption Architecture V3.0

skinparam componentStyle rectangle
skinparam shadowing false

actor "User" as user

package "KnowledgeOS System Boundary" {
  rectangle "macOS Application
Primary native client" as mac
  rectangle "iPhone Application
Mobile native client" as iphone
  rectangle "iPad Application
Tablet native client" as ipad
  rectangle "Web Application
Optional future client" as web
  rectangle "KnowledgeOS Core Runtime
Domain + Kernel + Platform + Integration + Execution" as runtime
  database "Local Durable Replica
Per-device operational state" as replica
  rectangle "Derived Local State
Indexes, caches, embeddings,
render artifacts" as derived
}

database "NAS
Library Source of Truth" as nas
cloud "External Providers and Services
AI, OCR, Export, Sync, Storage" as providers

user --> mac
user --> iphone
user --> ipad
user ..> web : Optional

mac --> runtime
iphone --> runtime
ipad --> runtime
web ..> runtime : Future / optional

runtime <--> replica : Durable local operations
runtime --> derived : Rebuildable derived state
runtime <--> nas : Synchronization and canonical persistence
runtime --> providers : Governed Integration contracts

note bottom of replica
  Not a competing Source of Truth.
  Supports Offline First operation.
end note

footer KnowledgeOS Architecture | C4 Model | Version 3.0
@enduml
